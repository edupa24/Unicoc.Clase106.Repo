@model IReadOnlyList<Producto>
@{ ViewData["Title"] = "Inventario"; }
<h1>Inventario</h1>
<p>Registrar productos y controlar entradas y salidas de unidades.</p>
<a class="boton" asp-action="Crear">Crear registro</a>
<p>@Model.Count registro(s)</p>
<div class="tabla">
<table>
    <thead><tr><th>Nombre</th><th>Categoría</th><th>Estado</th><th>Acciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nombre</td><td>@item.Detalle</td><td>@(item.Existencias.ToString())</td>
            <td class="acciones">
                <form asp-action="Retirar" method="post">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit">Retirar unidad</button>
                </form>
                <form asp-action="Reponer" method="post">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit">Ingresar unidad</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
